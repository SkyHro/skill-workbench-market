{
  "id": "workbench.markdown",
  "name": "诊断报告导出",
  "description": "在健康诊断中，将所选 Skill 的入口检查、断链位置与测试用例导出为 Markdown 文件。",
  "publisher": "Skill 工作台",
  "version": "2.0.0",
  "apiVersion": 1,
  "kind": "report.markdown",
  "trial": false,
  "template": {
    "body": "# {name} · 静态诊断报告\n\n快照指纹：{fingerprint}\n\n## 静态检查\n\n{findings}\n\n## 测试用例\n\n{cases}\n",
    "finding": "- {issue}",
    "reference": "- {from} 第 {line} 行 → {target} · {status}",
    "testCase": "- 输入：{input}\n  预期：{expected}",
    "emptyFindings": "未发现静态问题",
    "emptyCases": "尚无测试用例"
  }
}
